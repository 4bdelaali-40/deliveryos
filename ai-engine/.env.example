# ─────────────────────────────────────────
# DeliveryOS AI Engine — Environment Variables
# Copie ce fichier en .env et remplis les valeurs
# ─────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000
ENV=development

# Spring Boot backend (pour les callbacks)
BACKEND_URL=http://localhost:8080

# OpenRouteService API (distance matrix)
# Obtenir une clé gratuite sur https://openrouteservice.org
ORS_API_KEY=your_openrouteservice_api_key_here

# ML Models
MODEL_DIR=./models/saved
LOG_LEVEL=INFO